# Copy this file to .env (one directory up from this file, in the project root)
# and fill in your real keys. NEVER commit .env to version control.

# SerpAPI — live product search (Google Shopping)
# Get your key at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Razorpay — payment processing
# Get your keys at https://dashboard.razorpay.com/app/keys
# Use TEST keys during development (start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
